DATABASE_URL=postgresql+asyncpg://rigor:rigor@localhost:5432/rigor
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AI_PROVIDER=none
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_GENERATION_BATCH=5
AI_MAX_OUTPUT_TOKENS=3000
AI_REQUESTS_PER_MINUTE=10
# Optional operator-provided estimates; configure both from your current provider pricing.
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=
MAX_REQUEST_BYTES=200000
# Local values; production requires APP_ENV=production, a unique secret, secure cookies,
# SameSite=None, and a __Host- cookie name (see docs/DEPLOYMENT.md).
APP_ENV=development
DEMO_SESSION_SECRET=local-only-change-before-deploy-rigor-demo-secret
DEMO_COOKIE_SECURE=false
DEMO_COOKIE_SAMESITE=lax
DEMO_COOKIE_NAME=rigor_demo
DEMO_SESSION_DAYS=30
DEMO_IMPORTS_PER_MINUTE=3
DEMO_PLANS_PER_MINUTE=8
DEMO_SESSIONS_PER_MINUTE=4
DEMO_RESPONSES_PER_MINUTE=20
DEMO_MAX_IMPORTED_JOBS=10
DEMO_MAX_PLANS=20
DEMO_MAX_PRACTICE_SESSIONS=20
DEMO_MAX_ANSWERS=100
# Optional operator-only capability for approving/rejecting generated questions.
# Keep private; never add it to VITE_* variables or frontend code.
QUESTION_REVIEW_TOKEN=
